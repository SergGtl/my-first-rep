apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello-flask-deployment
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hello-flask
  template:
    metadata:
      labels:
        app: hello-flask
    spec:
      containers:
      - name: hello-flask
        image: your-dockerhub-username/hello-flask:latest
        ports:
        - containerPort: 5000