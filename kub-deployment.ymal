apiVersion: apps/v1
kind: Deployment
metadata:
  name: serg-flask-deployment
spec:
  replicas: 1
  selector:
    matchLabels:
      app: serg-flask
  template:
    metadata:
      labels:
        app: serg-flask
    spec:
      containers:
      - name: serg-flask
        image: sergg077/serg-flask:latest
        ports:
        - containerPort: 5000
